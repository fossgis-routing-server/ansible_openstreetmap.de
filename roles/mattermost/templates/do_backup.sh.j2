#!/bin/bash
# ==============================================================================
# Mattermost Comprehensive Backup Script
# Creates a database dump, backs up config and user data (data/ directory),
# and implements iterative/incremental backups using hardlinks.
# ==============================================================================

set -e

# Configuration Paths and Variables
MATTERMOST="{{ mattermost__install_dir }}"
MATTERMOSTB="{{ mattermost__backup_dir | default('/data/backup/mattermost') }}"
DB_HOST="{{ mattermost__db_host | default('localhost') }}"
DB_PORT="{{ mattermost__db_port | default(5432) }}"
DB_USER="{{ mattermost__db_user | default('postgres') }}"
DB_NAME="{{ mattermost__db_name | default('mattermost') }}"
RETENTION_DAYS=7

# Ensure main backup directory exists
mkdir -p "$MATTERMOSTB"
chown postgres:postgres "$MATTERMOSTB"
chmod 0750 "$MATTERMOSTB"

DTM=$(date +'%Y%m%d_%H%M%S')
CURRENT_BACKUP="$MATTERMOSTB/backup_$DTM"
LATEST_LINK="$MATTERMOSTB/latest"

echo "Starting Mattermost backup: $DTM"

# Create new backup directory
mkdir -p "$CURRENT_BACKUP"
chown postgres:postgres "$CURRENT_BACKUP"
chmod 0750 "$CURRENT_BACKUP"

# 1. Dump and compress PostgreSQL database
echo "Dumping PostgreSQL database..."
PGPASSWORD="{{ mattermost__db_password }}" pg_dump -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" | gzip > "$CURRENT_BACKUP/mattermost_$DTM.pgdump.gz"
chown postgres:postgres "$CURRENT_BACKUP/mattermost_$DTM.pgdump.gz"
chmod 0640 "$CURRENT_BACKUP/mattermost_$DTM.pgdump.gz"

# 2. Back up config.json
CONFIG_FILE="$MATTERMOST/config/config.json"
if [ -f "$CONFIG_FILE" ]; then
    echo "Backing up configuration file..."
    cp "$CONFIG_FILE" "$CURRENT_BACKUP/config.json"
    chown postgres:postgres "$CURRENT_BACKUP/config.json"
    chmod 0600 "$CONFIG_FILE" # beibehalten oder 0600
else
    echo "Warning: config.json not found at $CONFIG_FILE"
fi

# 3. Iterative / Incremental Backup of the Data Directory (using Hardlinks)
DATA_DIR="$MATTERMOST/data"
BACKUP_DATA_DIR="$CURRENT_BACKUP/data"

if [ -d "$DATA_DIR" ]; then
    echo "Backing up user data directory (incremental via hardlinks)..."
    if [ -d "$LATEST_LINK" ] && [ -d "$LATEST_LINK/data" ]; then
        # Copy existing files as hardlinks from the latest backup (saves space & time)
        cp -al "$LATEST_LINK/data" "$BACKUP_DATA_DIR"
        # rsync syncs only changes/new files into the hardlinked directory
        rsync -a --delete "$DATA_DIR/" "$BACKUP_DATA_DIR/"
    else
        # First run: regular copy if no previous 'latest' exists
        cp -a "$DATA_DIR" "$BACKUP_DATA_DIR"
    fi
    chown -R postgres:postgres "$BACKUP_DATA_DIR"
else
    echo "Warning: data directory not found at $DATA_DIR"
fi

# Update the 'latest' symlink for the next incremental run
rm -f "$LATEST_LINK"
ln -s "$CURRENT_BACKUP" "$LATEST_LINK"
chown -h postgres:postgres "$LATEST_LINK"

# 4. Retention Policy: Keep only the latest X backups
echo "Cleaning up old backups, keeping the latest $RETENTION_DAYS..."
cd "$MATTERMOSTB" || exit 1

find "$MATTERMOSTB" -mindepth 1 -maxdepth 1 -type d -name "backup_*" | sort -r | tail -n +$((RETENTION_DAYS + 1)) | while read -r old_backup; do
    echo "Removing old backup: $old_backup"
    rm -rf "$old_backup"
done

echo "Backup completed successfully!"