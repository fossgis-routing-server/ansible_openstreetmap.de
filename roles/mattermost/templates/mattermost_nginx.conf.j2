{% call server([mattermost__domain], http='forward', https='osmbc') %}

    # Allow large file uploads for Mattermost attachments
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:{{ mattermost__port }};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket-support (Required for Mattermost real-time notifications)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts and buffers for stable long-polling/WebSockets
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffers 256 16k;
        proxy_buffer_size 16k;
    }

    # Explicit WebSocket location path as recommended by Mattermost
    location /api/v4/websocket {
        proxy_pass http://127.0.0.1:{{ mattermost__port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    # Security provisions
    location ~ /\.(ht|git) {
        deny all;
    }

    {{ custom_log(mattermost__domain) }}
{% endcall %}