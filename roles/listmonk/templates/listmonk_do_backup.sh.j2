#!/usr/bin/env bash
set -euo pipefail

# Define backup directory including the 'listmonk' subdirectory
BACKUP_DIR="{{ (listmonk__backup_dir | default('/var/backups')) ~ '/listmonk' }}"
DB_NAME="{{ listmonk__db_name }}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="$BACKUP_DIR/listmonk_$TIMESTAMP.sql"

# Create database backup
su - postgres -c "pg_dump $DB_NAME" > "$BACKUP_FILE"

# Retention Policy: Keep only the latest 7 backups, purge older ones safely
echo "Cleaning up old backups, keeping the latest 7..."
cd "$BACKUP_DIR" || exit 1

# Find all backup files, sort them by name descending (newest first), 
# skip the first 7, and delete the rest.
find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type f -name "listmonk_*.sql" | sort -r | tail -n +8 | while read -r old_backup; do
    echo "Removing old backup: $old_backup"
    rm -f "$old_backup"
done

echo "Backup completed successfully!"