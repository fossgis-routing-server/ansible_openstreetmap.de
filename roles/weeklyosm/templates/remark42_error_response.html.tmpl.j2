<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width"/>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
</head>
<body>
<div style="text-align: center; font-family: Arial, sans-serif; font-size: 18px;">
    <!-- Rendered by Ansible/Jinja2 -->
    <h1 style="position: relative; color: #4fbbd6; margin-top: 0.2em;">{{ weeklyosm__remark42__email_template_brand }}</h1>

    <!-- Escaped for Remark42 Go templates -->
    {% raw %}
    <p style="position: relative; max-width: 20em; margin: 0 auto 1em auto; line-height: 1.4em;">{{.Error}}: {{.Details}}.</p>
    {% endraw %}
</div>
</body>
</html>