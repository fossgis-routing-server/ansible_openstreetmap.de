[Unit]
Description=Empty uMap Trash
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User={{ umap__user }}
Group=docker
WorkingDirectory={{ umap__paths.host.basedir }}
ExecStart=/usr/bin/docker exec umap_app umap empty_trash --days 30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
