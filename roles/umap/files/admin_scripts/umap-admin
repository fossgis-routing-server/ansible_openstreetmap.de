#!/bin/bash
# Allgemeines Wrapper-Script für alle uMap Admin-Skripte
# Ermöglicht einfachen Aufruf: ./umap-admin <command> [args...]

set -euo pipefail

# ============================================================================
# Konfiguration
# ============================================================================

readonly CONTAINER_NAME="${UMAP_CONTAINER_NAME:-umap_app}"
readonly ADMIN_SCRIPTS_DIR="/srv/umap/scripts/admin"

# ============================================================================
# Hilfsfunktionen
# ============================================================================

# Führt ein Python-Skript im Container aus
run_script() {
    local script_name="${1:-}"
    shift
    local script_path="${ADMIN_SCRIPTS_DIR}/${script_name}.py"
    
    if [ -z "$script_name" ]; then
        echo "Fehler: Kein Skriptname angegeben." >&2
        exit 1
    fi
    
    docker exec "$CONTAINER_NAME" /venv/bin/python3 "$script_path" "$@"
}

# Führt einen offiziellen uMap-CLI-Befehl im Container aus (ab uMap 3.6.2)
run_umap_cli() {
    docker exec "$CONTAINER_NAME" umap "$@"
}

# Prüft ob --help oder -h angegeben wurde
is_help_requested() {
    [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]
}

# Prüft ob Argumente fehlen
require_args() {
    [ $# -gt 0 ]
}

# ============================================================================
# Hilfe-Funktionen
# ============================================================================

show_help() {
    cat << EOF
Usage: $0 <command> [OPTIONS] [ARGS...]

Wrapper-Script für uMap Admin-Skripte zur Verwaltung und Analyse von uMap-Daten.

Commands:
    analyze users [OPTIONS]
        Zeigt User-Statistiken (Karten, Layer, Größe, Teams).
        Optionen: --top N, --sort SORT (maps|layers|size|teams|collaboration|username)

    analyze maps [OPTIONS]
        Analysiert Karten nach Größe und Aktivität.
        Optionen: --top N, --metric METRIC (size|layers|activity|inactive|largest-layers)

    get map <id>|<url> [OPTIONS]
        Zeigt Details einer Karte inklusive aller Layer und GeoJSON-Dateipfade.
        Optionen: --show-edit-link

    get user <id>|<username> [OPTIONS]
        Zeigt detaillierte Informationen zu einem User.
        Optionen: --include-trash (zeigt auch Karten im Papierkorb)

    search maps [TEXT] [OPTIONS]
        Offizielle uMap-CLI: Karten suchen und Aktionen (block/restore/delete).
        Optionen: --user USER, --id ID, --deleted, --public, --block, --restore, --delete, --dry-run, --no-input, --limit N

    empty trash [OPTIONS]
        Offizielle uMap-CLI: Papierkorb leeren (Karten endgültig entfernen).
        Optionen: --days N, --dry-run

    clear proxy-cache [OPTIONS]
        Offizielle uMap-CLI: Ajax-Proxy-Cache aufräumen (ab uMap 3.8.0).
        Optionen: --max-age N, --dry-run

    anonymous-edit-url <map_id> [OPTIONS]
        Offizielle uMap-CLI: Anonymer Bearbeitungslink zu einer Karte.
        Optionen: --lang LANG

    switch user <alter_user> <neuer_user> [OPTIONS]
        Offizielle uMap-CLI: Karten/Berechtigungen von einem User auf einen anderen übertragen.
        Optionen: --delete-user, --dry-run

Options:
    -h, --help    Zeigt diese Hilfe an

Examples:
    $0 analyze users --top 50 --sort size
    $0 analyze maps --metric activity --top 30
    $0 get map <MAP_ID>
    $0 get map <MAP_ID> --show-edit-link
    $0 get user <USER_ID>
    $0 get user <USER_ID> --include-trash
    $0 search maps --user <USERNAME> --dry-run
    $0 search maps --deleted --restore --no-input
    $0 empty trash --days 30 --dry-run
    $0 clear proxy-cache --max-age 86400 --dry-run
    $0 anonymous-edit-url <MAP_ID>
    $0 switch user alter_user neuer_user --dry-run
EOF
}

show_help_analyze_users() {
    cat << EOF
Usage: $0 analyze users [OPTIONS]

Zeigt User-Statistiken (Karten, Layer, Größe, Teams).

Options:
    --top N
        Anzahl der Top-Einträge (Standard: 20)

    --sort SORT
        Sortierung nach:
            maps           - Karten-Anzahl (Standard)
            layers         - Layer-Anzahl
            size           - Gesamtgröße
            teams          - Team-Anzahl
            collaboration  - Karten mit Real-time collaboration
            username       - Username (alphabetisch)

Examples:
    $0 analyze users --top 50 --sort size
EOF
}

show_help_analyze_maps() {
    cat << EOF
Usage: $0 analyze maps [OPTIONS]

Analysiert Karten nach Größe und Aktivität.

Options:
    --top N
        Anzahl der Top-Einträge (Standard: 20)

    --metric METRIC
        Metrik für die Auswertung:
            size           - Gesamtgröße (Standard)
            layers         - Layer-Anzahl
            activity       - Aktivität (letzte Änderung)
            inactive       - Inaktive Karten
            largest-layers - Größte einzelne Layer

Examples:
    $0 analyze maps --metric activity --top 30
    $0 analyze maps --metric inactive
EOF
}

show_help_get_map() {
    cat << EOF
Usage: $0 get map <id>|<url> [OPTIONS]

Zeigt Details einer Karte inklusive aller Layer und GeoJSON-Dateipfade.

Arguments:
    <id>                 Map-ID
    <url>                Vollständige URL oder Pfad zur Karte

Options:
    --show-edit-link
        Zeigt den anonymen Bearbeitungslink an

Examples:
    $0 get map <MAP_ID>
    $0 get map <MAP_ID> --show-edit-link
EOF
}

show_help_get_user() {
    cat << EOF
Usage: $0 get user <id>|<username>

Zeigt detaillierte Informationen zu einem User inklusive Statistiken,
Karten, Teams und Datenvolumen.

Arguments:
    <id>                 User-ID
    <username>           Username

Options:
    --include-trash   Zeigt auch Karten im Papierkorb (z. B. bei Meldung fehlender Karten).

Examples:
    $0 get user <USER_ID>
    $0 get user <USER_ID> --include-trash
EOF
}

show_help_search_maps() {
    cat << EOF
Usage: $0 search maps [TEXT] [OPTIONS]

Offizielle uMap-CLI (ab 3.6.2): Karten suchen und Aktionen ausführen.

Arguments:
    TEXT    Optional: Suchtext im Kartentitel (z. B. "spam")

Options:
    --user USER     Nur Karten dieses Users (Username)
    --id ID         Nur diese Map-ID
    --deleted       Nur gelöschte Karten (Papierkorb)
    --public        Nur öffentliche Karten
    --block         Gefundene Karten blockieren
    --restore       Gelöschte/blockierte Karten wiederherstellen
    --delete        Gefundene Karten in den Papierkorb verschieben
    --dry-run       Nur anzeigen, keine Aktionen
    --no-input      Keine Bestätigung abfragen (für Skripte)
    --limit N       Max. Anzahl Treffer (Standard: 100)

Examples:
    $0 search maps --user problemuser --dry-run
    $0 search maps --deleted --restore
    $0 search maps spam --block --no-input
EOF
}

show_help_empty_trash() {
    cat << EOF
Usage: $0 empty trash [OPTIONS]

Offizielle uMap-CLI: Papierkorb leeren (Karten endgültig löschen).

Options:
    --days N    Karten, die seit N Tagen im Papierkorb sind (Standard: 7)
    --dry-run   Nur anzeigen, nicht löschen

Examples:
    $0 empty trash --days 30 --dry-run
    $0 empty trash --days 30
EOF
}

show_help_clear_proxy_cache() {
    cat << EOF
Usage: $0 clear proxy-cache [OPTIONS]

Offizielle uMap-CLI: Ajax-Proxy-Cache-Einträge entfernen (ab uMap 3.8.0).

Options:
    --max-age N   Einträge älter als N Sekunden löschen (Standard: 86400)
    --dry-run     Nur anzeigen, nicht löschen

Examples:
    $0 clear proxy-cache --dry-run
    $0 clear proxy-cache --max-age 86400
EOF
}

show_help_anonymous_edit_url() {
    cat << EOF
Usage: $0 anonymous-edit-url <map_id> [OPTIONS]

Offizielle uMap-CLI: Gibt den anonymen Bearbeitungslink einer Karte aus.

Options:
    --lang LANG   Sprachcode für die URL (Standard: en)
EOF
}

show_help_switch_user() {
    cat << EOF
Usage: $0 switch user <alter_user> <neuer_user> [OPTIONS]

Offizielle uMap-CLI: Überträgt alle Karten/Rechte vom alten auf den neuen User.

Options:
    --delete-user   Alten User danach löschen
    --dry-run       Nur anzeigen, keine Änderungen

Examples:
    $0 switch user alter_account neuer_account --dry-run
EOF
}

# ============================================================================
# Kommando-Handler
# ============================================================================

handle_analyze_users() {
    shift 2  # Entferne "analyze users"
    
    if is_help_requested "${1:-}"; then
        show_help_analyze_users
        exit 0
    fi
    
    run_script "analyze_users" "$@"
}

handle_analyze_maps() {
    shift 2  # Entferne "analyze maps"
    
    if is_help_requested "${1:-}"; then
        show_help_analyze_maps
        exit 0
    fi
    
    run_script "analyze_maps" "$@"
}

handle_get_map() {
    shift 2  # Entferne "get map"
    
    if is_help_requested "${1:-}"; then
        show_help_get_map
        exit 0
    fi
    
    if ! require_args "$@"; then
        echo "Fehler: Map-ID oder URL erforderlich." >&2
        echo "" >&2
        echo "Verwendung: $0 get map <map_id>|<url> [OPTIONS]" >&2
        echo "Führe '$0 get map --help' aus für Details." >&2
        exit 1
    fi
    
    run_script "get_map_details" "$@"
}

handle_get_user() {
    shift 2  # Entferne "get user"
    
    if is_help_requested "${1:-}"; then
        show_help_get_user
        exit 0
    fi
    
    if ! require_args "$@"; then
        echo "Fehler: User-ID oder Username erforderlich." >&2
        echo "" >&2
        echo "Verwendung: $0 get user <user_id>|<username> [--include-trash]" >&2
        echo "Führe '$0 get user --help' aus für Details." >&2
        exit 1
    fi
    
    run_script "get_user_details" "$@"
}

handle_search_maps() {
    shift 2  # Entferne "search maps"
    if is_help_requested "${1:-}"; then
        show_help_search_maps
        exit 0
    fi
    run_umap_cli search_maps "$@"
}

handle_empty_trash() {
    shift 2  # Entferne "empty trash"
    if is_help_requested "${1:-}"; then
        show_help_empty_trash
        exit 0
    fi
    run_umap_cli empty_trash "$@"
}

handle_clear_proxy_cache() {
    shift 2  # Entferne "clear proxy-cache"
    if is_help_requested "${1:-}"; then
        show_help_clear_proxy_cache
        exit 0
    fi
    run_umap_cli clear_proxy_cache "$@"
}

handle_anonymous_edit_url() {
    shift  # Entferne "anonymous-edit-url"
    if is_help_requested "${1:-}"; then
        show_help_anonymous_edit_url
        exit 0
    fi
    if ! require_args "$@"; then
        echo "Fehler: Map-ID erforderlich." >&2
        echo "Verwendung: $0 anonymous-edit-url <map_id> [--lang LANG]" >&2
        exit 1
    fi
    run_umap_cli anonymous_edit_url "$@"
}

handle_switch_user() {
    shift 2  # Entferne "switch user"
    if is_help_requested "${1:-}"; then
        show_help_switch_user
        exit 0
    fi
    if [ $# -lt 2 ]; then
        echo "Fehler: alter_user und neuer_user erforderlich." >&2
        echo "Verwendung: $0 switch user <alter_user> <neuer_user> [--delete-user] [--dry-run]" >&2
        exit 1
    fi
    run_umap_cli switch_user "$@"
}

# ============================================================================
# Hauptlogik
# ============================================================================

main() {
    case "${1:-}" in
        search)
            if [ "${2:-}" = "maps" ]; then
                handle_search_maps "$@"
            else
                echo "Fehler: Unbekanntes Such-Kommando: ${2:-}" >&2
                echo "Verwendung: $0 search maps [TEXT] [OPTIONS]" >&2
                exit 1
            fi
            ;;
        empty)
            if [ "${2:-}" = "trash" ]; then
                handle_empty_trash "$@"
            else
                echo "Fehler: Unbekanntes Kommando: ${2:-}" >&2
                echo "Verwendung: $0 empty trash [--days N] [--dry-run]" >&2
                exit 1
            fi
            ;;
        clear)
            if [ "${2:-}" = "proxy-cache" ]; then
                handle_clear_proxy_cache "$@"
            else
                echo "Fehler: Unbekanntes Kommando: ${2:-}" >&2
                echo "Verwendung: $0 clear proxy-cache [--max-age N] [--dry-run]" >&2
                exit 1
            fi
            ;;
        anonymous-edit-url)
            handle_anonymous_edit_url "$@"
            ;;
        switch)
            if [ "${2:-}" = "user" ]; then
                handle_switch_user "$@"
            else
                echo "Fehler: Unbekanntes Kommando: ${2:-}" >&2
                echo "Verwendung: $0 switch user <alter_user> <neuer_user> [OPTIONS]" >&2
                exit 1
            fi
            ;;
        analyze)
            case "${2:-}" in
                users)
                    handle_analyze_users "$@"
                    ;;
                maps)
                    handle_analyze_maps "$@"
                    ;;
                *)
                    echo "Fehler: Unbekanntes Analyse-Kommando: ${2:-}" >&2
                    echo "Verwendung: $0 analyze users|maps [OPTIONS]" >&2
                    echo "Führe '$0 help' aus für eine Liste verfügbarer Kommandos." >&2
                    exit 1
                    ;;
            esac
            ;;
        
        get)
            case "${2:-}" in
                map)
                    handle_get_map "$@"
                    ;;
                user)
                    handle_get_user "$@"
                    ;;
                *)
                    echo "Fehler: Unbekanntes Get-Kommando: ${2:-}" >&2
                    echo "Verwendung: $0 get map|user [ARGS...]" >&2
                    echo "Führe '$0 help' aus für eine Liste verfügbarer Kommandos." >&2
                    exit 1
                    ;;
            esac
            ;;
        
        list|help|--help|-h)
            show_help
            exit 0
            ;;
        
        *)
            if [ -z "${1:-}" ]; then
                echo "Fehler: Kein Kommando angegeben." >&2
            else
                echo "Fehler: Unbekanntes Kommando: $1" >&2
            fi
            echo "" >&2
            echo "Verwendung: $0 <command> [OPTIONS] [ARGS...]" >&2
            echo "Führe '$0 help' aus für eine Liste verfügbarer Kommandos." >&2
            exit 1
            ;;
    esac
}

main "$@"
