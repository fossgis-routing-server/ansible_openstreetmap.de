    vars.totalprocs = {
        procs_warning = ":1200"
        procs_critical = ":2000"
    }

{% for mntpt in ('/', '/srv') %}
    vars.disks["disk {{ mntpt }}"] = {
        disk_partitions = "{{ mntpt }}"
        disk_exact_match = true
        disk_cfree = "10%"
        disk_wfree = "15%"
    }

{% endfor %}

    vars.service["service nginx"] = {
        vars.systemd_service = "nginx"
    }

