{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "enabledManagers": [
        "custom.regex"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "^roles/mattermost/defaults/main\\.yml$"
            ],
            "matchStrings": [
                "mattermost__version:\\s*[\"']?(?<currentValue>[\\d\\.]+)[ \"']?"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "mattermost/mattermost-server"
        },
        {
            "customType": "regex",
            "fileMatch": [
                "^roles/listmonk/defaults/main\\.yml$"
            ],
            "matchStrings": [
                "listmonk__version:\\s*[\"']?(?<currentValue>[\\d\\.]+)[ \"']?"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "knadh/listmonk"
        },
        {
            "customType": "regex",
            "fileMatch": [
                "^roles/weeklyosm/defaults/main\\.yml$"
            ],
            "matchStrings": [
                "weeklyosm__remark42__version:\\s*[\"']?v?(?<currentValue>[\\d\\.]+)[ \"']?"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "umputun/remark42"
        }
    ],
    "packageRules": [
        {
            "matchFileNames": [
                "roles/mattermost/defaults/main\\.yml",
                "roles/listmonk/defaults/main\\.yml",
                "roles/weeklyosm/defaults/main\\.yml"
            ],
            "assignees": [
                "Matthias",
                "Sven_Fischer"
            ]
        }
    ]
}