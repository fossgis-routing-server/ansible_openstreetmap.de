{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:base"],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": ["^roles/mattermost/defaults/main\\.yml$"],
            "matchStrings": ["mattermost__version:\\s*[\"']?(?<currentValue>[\\d\\.]+)[ \"']?"],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "mattermost/mattermost"
        },
        {
            "customType": "regex",
            "fileMatch": ["^roles/listmonk/defaults/main\\.yml$"],
            "matchStrings": ["listmonk__version:\\s*[\"']?(?<currentValue>[\\d\\.]+)[ \"']?"],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "listmonk/listmonk"
        },
        {
            "customType": "regex",
            "fileMatch": ["^roles/weeklyosm/defaults/main\\.yml$"],
            "matchStrings": ["weeklyosm__remark42__version:\\s*[\"']?v?(?<currentValue>[\\d\\.]+)[ \"']?"],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "umputun/remark42"
        }
    ]
}
